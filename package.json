{
  "name": "fd-mate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "concurrently -k -n emu,web -c blue,green \"npm run emu\" \"vite frontend\"",
    "emu": "firebase emulators:start --only auth,database --project vue-demo-5e240",
    "build": "vite build frontend",
    "format": "prettier --write .",
    "check": "tsc --noEmit -p frontend/tsconfig.json && eslint .",
    "test": "vitest run --root frontend"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "firebase-tools": "^15.34.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.105.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "firebase": "^13.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
